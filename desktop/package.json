{
  "name": "focusmask-desktop",
  "version": "1.0.0",
  "description": "Focus Mask Desktop App - Blur and darken desktop apps outside your focus area",
  "main": "src/main/index.js",
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "vite build && electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
